# prediction_analytics.py - خدمة تحليل التوقعات والإحصائيات

from flask import Flask, request, jsonify
import pandas as pd
import numpy as np
from sklearn.metrics import mean_squared_error
import logging
import requests
import json

app = Flask(__name__)

# إعداد التسجيل
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# الاتصال بخدمة Node.js
NODE_API_URL = 'http://localhost:5000/api'

@app.route('/calculate-leaderboard', methods=['GET'])
def calculate_leaderboard():
    """حساب قائمة المتصدرين باستخدام خوارزميات التعلم الآلي"""
    try:
        # جلب بيانات التوقعات من خدمة Node.js
        predictions_response = requests.get(f"{NODE_API_URL}/predictions")
        predictions_data = predictions_response.json()
        
        # جلب بيانات المباريات الحقيقية
        matches_response = requests.get(f"{NODE_API_URL}/matches/completed")
        matches_data = matches_response.json()
        
        # تحويل البيانات إلى إطارات بيانات pandas
        predictions_df = pd.DataFrame(predictions_data)
        matches_df = pd.DataFrame(matches_data)
        
        # حساب دقة التوقعات
        if not predictions_df.empty and not matches_df.empty:
            # إنشاء قاموس للمباريات المكتملة للبحث السريع
            matches_dict = {match['id']: match for match in matches_data}
            
            # حساب النقاط لكل توقع
            user_points = {}
            
            for _, prediction in predictions_df.iterrows():
                user_id = prediction['userId']
                match_id = prediction['matchId']
                
                # التحقق مما إذا كانت المباراة مكتملة
                if match_id in matches_dict:
                    match = matches_dict[match_id]
                    
                    # حساب النقاط
                    points = calculate_points(
                        prediction['homeScore'],
                        prediction['awayScore'],
                        match['homeScore'],
                        match['awayScore']
                    )
                    
                    # إضافة النقاط للمستخدم
                    if user_id not in user_points:
                        user_points[user_id] = {'points': 0, 'correct': 0, 'total': 0}
                    
                    user_points[user_id]['points'] += points
                    user_points[user_id]['total'] += 1
                    
                    if points > 0:
                        user_points[user_id]['correct'] += 1
            
            # تحويل بيانات النقاط إلى قائمة للواجهة
            leaderboard = []
            
            # جلب بيانات المستخدمين
            users_response = requests.get(f"{NODE_API_URL}/users")
            users_data = users_response.json()
            users_dict = {user['id']: user for user in users_data}
            
            for user_id, stats in user_points.items():
                user_info = users_dict.get(user_id, {'username': f'مستخدم {user_id}', 'fullName': ''})
                
                leaderboard.append({
                    'userId': user_id,
                    'username': user_info['username'],
                    'fullName': user_info.get('fullName', ''),
                    'points': stats['points'],
                    'correctPredictions': stats['correct'],
                    'totalPredictions': stats['total'],
                    'accuracy': round((stats['correct'] / stats['total']) * 100, 2) if stats['total'] > 0 else 0
                })
            
            # ترتيب القائمة حسب النقاط
            leaderboard.sort(key=lambda x: x['points'], reverse=True)
            
            # إضافة الترتيب
            for i, entry in enumerate(leaderboard):
                entry['rank'] = i + 1
            
            return jsonify(leaderboard)
        
        return jsonify([])
    
    except Exception as e:
        logger.error(f"Error calculating leaderboard: {str(e)}")
        return jsonify([])

def calculate_points(pred_home, pred_away, actual_home, actual_away):
"""حساب النقاط بناءً على دقة التوقع"""
    # نتيجة مطابقة تماماً
    if pred_home == actual_home and pred_away == actual_away:
        return 3
    
    # توقع الفائز بشكل صحيح
    pred_result = get_result(pred_home, pred_away)
    actual_result = get_result(actual_home, actual_away)
    
    if pred_result == actual_result:
        return 1
    
    return 0

def get_result(home, away):
    """تحديد نتيجة المباراة (فوز المنزل، تعادل، فوز الضيف)"""
    if home > away:
        return 'H'
    elif home < away:
        return 'A'
    else:
        return 'D'

