// معالجة اتصالات WebSocket
wss.on('connection', (ws) => {
  console.log('WebSocket client connected');
  
  // إرسال تحديثات المباريات المباشرة كل 30 ثانية
  const interval = setInterval(() => {
    if (ws.readyState === ws.OPEN) {
      sendLiveMatchUpdates(ws);
    }
  }, 30000);
  
  ws.on('message', (message) => {
    try {
      const data = JSON.parse(message);
      console.log('Received message:', data);
      
      // معالجة الرسائل المستلمة
      if (data.type === 'ping') {
        ws.send(JSON.stringify({ type: 'pong', timestamp: Date.now() }));
      }
    } catch (error) {
      console.error('Error processing message:', error);
    }
  });
  
  ws.on('close', () => {
    console.log('WebSocket client disconnected');
    clearInterval(interval);
  });
});

// دالة لإرسال تحديثات المباريات المباشرة
async function sendLiveMatchUpdates(ws) {
  try {
    // جلب البيانات من API الداخلي
    const response = await axios.get('http://localhost:5000/api/matches/live');
    const liveMatches = response.data;
    
    // إرسال التحديثات للعميل
    ws.send(JSON.stringify({
      type: 'liveMatches',
      data: liveMatches,
      timestamp: Date.now()
    }));
  } catch (error) {
    console.error('Error sending live match updates:', error);
  }
}

