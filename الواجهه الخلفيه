            "- نصف النهائي يقام في 22 و23 يونيو 2034 " +
            "- النهائي سيقام في 30 يونيو 2034";
    }
    
    @PostMapping("/process")
    public Map<String, Object> processQuestion(@RequestBody Map<String, String> request) {
        String question = request.get("question");
        String userId = request.getOrDefault("userId", "guest");
        String language = request.getOrDefault("language", "ar");
        
        Map<String, Object> response = new HashMap<>();
        
        // التحقق من تقييد معدل الاستخدام
        if (isRateLimited(userId)) {
            response.put("error", "Rate limit exceeded. Please try again later.");
            response.put("answer", "عذراً، لقد تجاوزت الحد المسموح من الأسئلة. يرجى المحاولة مرة أخرى بعد قليل.");
            return response;
        }
        
        // إذا كان السؤال فارغاً أو قصيراً جداً
        if (question == null || question.trim().length() < 3) {
            response.put("error", "Question is too short");
            response.put("answer", "يرجى طرح سؤال أكثر تفصيلاً");
            return response;
        }
        
        try {
            // البحث أولاً في قاعدة المعرفة المحلية
            String knowledgeBaseAnswer = searchKnowledgeBase(question);
            
            if (knowledgeBaseAnswer != null) {
                response.put("answer", knowledgeBaseAnswer);
                response.put("source", "knowledge_base");
                return response;
            }
            
            // استخدام Anthropic Claude AI
            String aiAnswer = callAnthropicAI(question, language);
            response.put("answer", aiAnswer);
            response.put("source", "ai");
            
            // تحديث قاعدة المعرفة المحلية
updateKnowledgeBase(question, aiAnswer);
            
        } catch (Exception e) {
            e.printStackTrace();
            response.put("error", "Failed to process question: " + e.getMessage());
            response.put("answer", "عذراً، حدث خطأ أثناء معالجة سؤالك. يرجى المحاولة مرة أخرى لاحقاً.");
        }
        
        return response;
    }
    
    private boolean isRateLimited(String userId) {
        // تنفيذ آلية تقييد معدل الاستخدام البسيطة
        LocalDateTime now = LocalDateTime.now();
        LocalDateTime lastRequest = rateLimits.get(userId);
        
        if (lastRequest != null) {
            long secondsSinceLastRequest = java.time.Duration.between(lastRequest, now).getSeconds();
            
            // السماح بسؤال واحد كل 10 ثواني لكل مستخدم
            if (secondsSinceLastRequest < 10) {
                return true;
            }
        }
        
        // تحديث وقت آخر طلب
        rateLimits.put(userId, now);
        return false;
    }
    
    private String searchKnowledgeBase(String question) {
        // البحث في قاعدة المعرفة المحلية
        Map<String, String> knowledgeBase = getLocalKnowledgeBase();
        
        // تبسيط السؤال للبحث
        String simplifiedQuestion = question.toLowerCase()
            .replaceAll("[\\p{Punct}&&[^؟]]", "")
            .trim();
        
        // البحث عن تطابق
        for (Map.Entry<String, String> entry : knowledgeBase.entrySet()) {
            if (simplifiedQuestion.contains(entry.getKey())) {
                return entry.getValue();
            }
        }
        
        return null;
    }
    
    private Map<String, String> getLocalKnowledgeBase() {
        // قاعدة معرفة بسيطة للأسئلة الشائعة
        Map<String, String> knowledgeBase = new HashMap<>();
        
        knowledgeBase.put("متى تبدأ", "تبدأ بطولة كأس العالم 2034 في 15 يونيو 2034 وتستمر حتى 30 يونيو 2034.");
