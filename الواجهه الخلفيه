        # نموذج تبسيطي للتوضيح
        home_win_prob = np.random.uniform(0.3, 0.7)
        draw_prob = np.random.uniform(0.1, 0.3)
        away_win_prob = 1 - home_win_prob - draw_prob
        
        most_likely_score = predict_most_likely_score(home_team, away_team)
        
        return jsonify({
            'homeTeam': home_team,
            'awayTeam': away_team,
            'predictions': {
                'homeWinProbability': round(home_win_prob, 2),
                'drawProbability': round(draw_prob, 2),
                'awayWinProbability': round(away_win_prob, 2),
                'mostLikelyScore': most_likely_score
            }
        })
    
    except Exception as e:
        logger.error(f"Error predicting match outcome: {str(e)}")
        return jsonify({'error': str(e)}), 500

