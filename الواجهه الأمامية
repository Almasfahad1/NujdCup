// تنفيذ المساعد الذكي (محاكاة بسيطة)
const smartAssistant = {
  ask: function(question) {
    const commonResponses = {
      'متى تبدأ البطولة': 'تبدأ بطولة كأس العالم 2034 في يونيو 2034.',
      'كم عدد الفرق المشاركة': 'يشارك في كأس العالم 2034 32 منتخبًا من مختلف دول العالم.',
      'أين ستقام البطولة': 'ستقام بطولة كأس العالم 2034 في المملكة العربية السعودية.',
      'من هو حامل اللقب': 'الأرجنتين هي حاملة لقب كأس العالم 2022 التي أقيمت في قطر.'
    };
    
    // تبسيط السؤال للبحث
    const simplifiedQuestion = question.toLowerCase().trim();
    
    // البحث عن إجابة مطابقة
    for (const [key, value] of Object.entries(commonResponses)) {
      if (simplifiedQuestion.includes(key)) {
        return value;
      }
    }
    
    // إجابة افتراضية إذا لم يتم العثور على مطابقة
    return 'عذراً، لا أستطيع الإجابة على هذا السؤال حاليًا. يمكنك طرح سؤال آخر أو التواصل مع فريق الدعم.';
  }
};

// نموذج لاستخدام المساعد الذكي
document.addEventListener('DOMContentLoaded', function() {
  const assistantForm = document.querySelector('.smart-assistant-form');
  if (assistantForm) {
    assistantForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const questionInput = this.querySelector('input[name="question"]');
      const question = questionInput.value.trim();
      
      if (question) {
        const answer = smartAssistant.ask(question);
        
        // عرض الإجابة في واجهة المستخدم
        const responseContainer = document.createElement('div');
        responseContainer.className = 'assistant-response';
        responseContainer.innerHTML = `
          <div class="question"><strong>سؤالك:</strong> ${question}</div>
          <div class="answer"><strong>الإجابة:</strong> ${answer}</div>
        `;
        
        const responsesArea = document.querySelector('.assistant-responses');
        if (responsesArea) {
          responsesArea.prepend(responseContainer);
        }
        
        // مسح حقل الإدخال
        questionInput.value = '';
      }
    });
  }
});
